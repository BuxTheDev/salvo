# Salvo — optional environment variables. The app runs fully client-side
# (see README "Current persistence model") without any of these set.

# Supabase project (browser client)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key — server-only, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
