{
  "name": "salvo-dev-harness",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "description": "Local dev harness that mounts the Salvo.jsx prototype for development.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "next:dev": "next dev -p 3000",
    "next:build": "next build",
    "next:start": "next start -p 3000",
    "render:lois": "tsx scripts/render_lois.jsx",
    "server": "tsx server/index.js",
    "server:dev": "tsx watch server/index.js",
    "supabase:check": "node scripts/supabase_check.mjs"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.5.1",
    "@supabase/supabase-js": "^2.110.8",
    "express": "^5.2.1",
    "jszip": "^3.10.1",
    "next": "^16.2.11",
    "papaparse": "^5.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.4",
    "tsx": "^4.23.1",
    "vite": "^8.1.5"
  }
}
